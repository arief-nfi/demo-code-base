# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/saas_db?schema=public"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated origins. Supports exact URLs and wildcards (* matches any chars).
# Examples:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
#   CORS_ORIGINS=https://*.coder.example.com           (Coder workspace pattern)
#   CORS_ORIGINS=https://3000--*--user.coder.example.com
CORS_ORIGINS=http://localhost:3000

# ─── Swagger UI ───────────────────────────────────────────────────────────────
# Interactive API docs. Disable in production to avoid leaking endpoint shapes.
SWAGGER_ENABLED=true
SWAGGER_PATH=/   # Path the UI is served from. Use '/api' to keep the old behaviour.

# ─── Helmet security headers ──────────────────────────────────────────────────
# Both default to enabled. Disable when:
#  - HELMET_FRAMEGUARD=false  → embedding the API in an iframe (e.g. Coder workspace previews).
#  - HELMET_CSP=false         → Swagger UI's inline scripts are blocked, or you serve a third-party UI.
HELMET_FRAMEGUARD=true
HELMET_CSP=true

# ─── Reverse Proxy ────────────────────────────────────────────────────────────
# Required when behind nginx, Coder, Cloudflare, etc. so Express honors
# X-Forwarded-Proto / X-Forwarded-For. Without this, req.secure is always false
# and Secure cookies may not behave correctly.
# TRUST_PROXY=true       # trust all proxies (typical for nginx in front of API)
# TRUST_PROXY=1          # trust only one hop
# TRUST_PROXY=10.0.0.0/8 # trust a CIDR range

# ─── Cookies ──────────────────────────────────────────────────────────────────
# HTTPS is terminated by the reverse proxy (e.g. nginx) in front of the API.
# When running behind HTTPS, set COOKIE_SECURE=true so browsers only send cookies
# over TLS even though the API itself speaks plain HTTP to the proxy.
# COOKIE_SECURE=auto    # 'auto' = secure when NODE_ENV=production
#                       # 'true' = force secure (use behind HTTPS proxy in dev too)
#                       # 'false' = plain HTTP dev only
# COOKIE_SAME_SITE=strict  # 'strict' | 'lax' | 'none'
#                          # Use 'none' for cross-origin (different subdomain) HTTPS — requires secure=true
#                          # Use 'lax' when web + API are on the same origin (same subdomain via nginx)
# COOKIE_DOMAIN=.example.com  # Optional — share cookies across subdomains
# ACCESS_COOKIE_PATH=/         # Path for the access token cookie
# REFRESH_COOKIE_PATH=/        # Path for the refresh token cookie. Default '/' is safest with proxies.
#                              # Set to '/auth/refresh' for slightly tighter scoping if your proxy doesn't rewrite paths.

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ACCESS_EXPIRES_IN=15m   # Short-lived access token (recommended: 15m)
JWT_REFRESH_EXPIRES_IN=7d   # Refresh token lifetime (recommended: 7d)

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
DEFAULT_ADMIN_PASSWORD=change-this-in-prod  # pnpm db:seed gives admin@system this password (min 8 characters)
PASSWORD_RESET_EXPIRES_MS=3600000  # 1 hour in milliseconds

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60       # Time window in seconds for global rate limit
THROTTLE_LIMIT=100            # Max requests per window (global)
THROTTLE_AUTH_TTL_SECONDS=60  # Time window in seconds for auth endpoints
THROTTLE_AUTH_LIMIT=5         # Max requests per window (auth: login, forgot-password, etc.)

# ─── Redis (docker-compose maps it to 6380) ──────────────────────────────────
# The job queues (email, webhook, calendar, export, import) need it: without REDIS_URL they try
# localhost:6379. The cache alone falls back to memory.
REDIS_URL=redis://localhost:6380

# ─── Database Pooling ────────────────────────────────────────────────────────
MAX_TENANT_CLIENTS=50  # Max concurrent tenant DB clients (LRU eviction when full)

# ─── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Outbound Webhooks (SSRF protection) ─────────────────────────────────────
# Webhook URLs must be http(s) and resolve only to public addresses; loopback,
# private (10/8, 172.16/12, 192.168/16), link-local / cloud metadata
# (169.254.169.254), CGNAT, IPv6 ULA/link-local etc. are rejected when the
# webhook is saved and again on every delivery. Redirects are never followed.
# Set to true ONLY for local development (e.g. a receiver on localhost).
# ALLOW_PRIVATE_WEBHOOK_URLS=false

# ─── Email Configuration ─────────────────────────────────────────────────────
# Every email is queued and logged (Systems → Email). Unset SMTP_HOST or MAIL_FROM →
# emails are logged as SKIPPED, not sent. TLS is used when SMTP_PORT is 465.
# Local development: run Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
# and use SMTP_HOST=localhost SMTP_PORT=1025 with empty SMTP_USER/SMTP_PASS; read the
# mail at http://localhost:8025. Production example: SMTP_HOST=mail.smtp2go.com SMTP_PORT=2525
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=SaaS Admin
# Public URL of this API: makes tenant logo URLs in emails absolute
API_PUBLIC_URL=http://localhost:3001
# Days to keep the email log
EMAIL_LOG_RETENTION_DAYS=90

# ─── Web app (apps/web reads the NEXT_PUBLIC_* lines of this file) ──────────
# Where the browser reaches the API. Built into the web bundle: restart `pnpm dev` (or rebuild)
# after changing it. An apps/web/.env.local, if you keep one, overrides it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Frontend URL (for password reset links) ─────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Plugin billing ──────────────────────────────────────────────────────────
# Payment provider for paid plugins. No default: unset = paid plugins unavailable.
# `fake` = test-mode payment page (dev/staging only). Xendit is not implemented yet.
BILLING_PROVIDER=fake
# Shared secret the provider sends in the x-callback-token header.
BILLING_CALLBACK_TOKEN=change-me
# BILLING_FAKE_ALLOWED=true  # only for a staging box running NODE_ENV=production

# ─── Google Calendar (Integration plugin) ────────────────────────────────────
# OAuth client of type "Web application" from Google Cloud. Redirect URI to register:
#   ${FRONTEND_URL}/plugins/integration/google-calendar/callback
# Leave unset to keep Google Calendar switched off ("not configured").
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Encrypts stored OAuth refresh tokens. 32 bytes, base64: openssl rand -base64 32
# INTEGRATION_ENCRYPTION_KEY=

# ─── Contact Sales Email ─────────────────────────────────────────────────────
SALES_EMAIL=sales@example.com

# ─── Tenant Migrations ──────────────────────────────────────────────────────
# After schema changes, run: pnpm db:migrate:tenants
