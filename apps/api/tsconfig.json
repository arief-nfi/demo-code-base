{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@saas/database": [
        "../../packages/database/src"
      ],
      "@saas/plugin-audit-log": [
        "../../plugins/audit-log/src"
      ],
      "@saas/plugin-audit-log/*": [
        "../../plugins/audit-log/src/*"
      ],
      "@saas/plugin-document-templates": [
        "../../plugins/document-templates/src"
      ],
      "@saas/plugin-document-templates/*": [
        "../../plugins/document-templates/src/*"
      ],
      "@saas/plugin-integration": [
        "../../plugins/integration/src"
      ],
      "@saas/plugin-integration/config-schema": [
        "../../plugins/integration/src/config.schema"
      ],
      "@saas/plugin-integration/*": [
        "../../plugins/integration/src/*"
      ],
      "@saas/sample-plugin": [
        "../../plugins/sample-plugin/src"
      ],
      "@saas/sample-plugin/*": [
        "../../plugins/sample-plugin/src/*"
      ]
    }
  }
}