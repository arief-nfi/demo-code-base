{
  "name": "@saas/plugin-audit-log",
  "description": "Audit Log Plugin for SaaS Application",
  "version": "1.0.0",
  "displayName": "Audit Log",
  "pluginManifest": {
    "key": "audit-log",
    "displayName": "Audit Log",
    "description": "Activity tracking with hash chain verification",
    "category": "security",
    "tags": ["audit", "compliance", "logging"],
    "sdkVersion": "1",
    "coreCompatibility": ">=0.0.0",
    "pluginDependencies": {},
    "pluginConflicts": []
  },
  "author": {
    "name": "Developer",
    "email": "developer@neo-fusion.com",
    "url": "https://git.neo-fusion.com/arief/saas-multitenant"
  },
  "private": true,
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./menus": {
      "types": "./dist/web/menus.d.ts",
      "default": "./dist/web/menus.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./dictionaries": {
      "types": "./dist/dictionaries.d.ts",
      "default": "./dist/dictionaries.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@saas/backend": "workspace:*",
    "@saas/ui": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "zod": "^4.1.13",
    "lucide-react": "^0.359.0",
    "sonner": "^2.0.7"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  }
}
