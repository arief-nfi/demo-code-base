{
  "name": "@saas/plugin-integration",
  "description": "Partners, webhooks and API keys for external integrations, plus Google Calendar sync and Google Meet meetings",
  "version": "1.0.0",
  "displayName": "Integration",
  "pluginManifest": {
    "key": "integration",
    "displayName": "Integration",
    "description": "Partners, webhooks and API keys for external integrations, plus Google Calendar sync and Google Meet meetings",
    "category": "integration",
    "tags": ["integration", "webhook", "api-key", "partner"],
    "sdkVersion": "1",
    "coreCompatibility": ">=0.0.0",
    "pluginDependencies": {},
    "pluginConflicts": []
  },
  "author": {
    "name": "Developer",
    "email": "developer@neo-fusion.com",
    "url": "https://git.neo-fusion.com/arief/saas-multitenant"
  },
  "private": true,
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./menus": {
      "types": "./dist/web/menus.d.ts",
      "default": "./dist/web/menus.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./dictionaries": {
      "types": "./dist/dictionaries.d.ts",
      "default": "./dist/dictionaries.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle.d.ts",
      "default": "./dist/lifecycle.js"
    },
    "./config-schema": {
      "types": "./dist/config.schema.d.ts",
      "default": "./dist/config.schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@saas/backend": "workspace:*",
    "@saas/database": "workspace:*",
    "@saas/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.359.0",
    "react-hook-form": "^7.48.0",
    "reflect-metadata": "^0.1.13",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.0.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.1.3"
  }
}
